*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0b0a1f;--panel:#151333;--panel2:#1d1a42;--line:#322c63;
  --ink:#f3f1ff;--mut:#9a93c9;
  --magenta:#ff2d7e;--violet:#8b5cff;--teal:#19e0d6;--lime:#c6ff4e;--gold:#ffce3a;
  --accent:#19e0d6;--accent2:#ff2d7e;
  --radius:18px;
  --grad:linear-gradient(100deg,var(--magenta),var(--violet) 45%,var(--teal));
}
*::selection{background:var(--magenta);color:#fff}
html,body{font-family:'Archivo',system-ui,sans-serif;color:var(--ink);min-height:100vh;
  background:
    radial-gradient(680px 380px at 88% -8%,rgba(255,45,126,.18),transparent),
    radial-gradient(620px 420px at -8% 8%,rgba(139,92,255,.18),transparent),
    radial-gradient(700px 500px at 50% 120%,rgba(25,224,214,.12),transparent),
    var(--bg);}
body{padding-bottom:64px}
a{color:inherit}
.wrap{max-width:860px;margin:0 auto;padding:0 18px}
.band{position:relative;overflow:hidden;border-bottom:1px solid var(--line);
  background:
    radial-gradient(500px 200px at 20% 0%,rgba(255,45,126,.25),transparent),
    radial-gradient(500px 240px at 85% 120%,rgba(25,224,214,.22),transparent),
    linear-gradient(180deg,#120f2c,#0b0a1f)}
.band::before{content:"";position:absolute;inset:0;
  background-image:repeating-linear-gradient(90deg,rgba(255,255,255,.04) 0 1px,transparent 1px 64px);pointer-events:none}
.bandinner{max-width:860px;margin:0 auto;padding:30px 18px 26px;position:relative;text-align:center}
.kicker{font-family:'Archivo';font-weight:700;letter-spacing:.32em;font-size:11px;text-transform:uppercase;color:var(--teal);margin-bottom:10px}
.logo{font-family:'Anton',sans-serif;font-weight:400;line-height:.86;font-size:clamp(40px,9vw,76px);letter-spacing:.5px;text-transform:uppercase}
.logo .g{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.sub{color:var(--mut);font-size:13px;margin-top:10px;letter-spacing:.04em}
.who{display:flex;gap:8px;align-items:center;justify-content:center;flex-wrap:wrap;font-size:13px;color:var(--mut);margin-top:16px}
.tag{background:rgba(255,255,255,.05);border:1px solid var(--line);padding:5px 12px;border-radius:999px;font-weight:600;font-size:12px}
.tag.gold{color:var(--gold);border-color:#6a5410;background:rgba(255,206,58,.08)}
.btn{font-family:inherit;cursor:pointer;border:1px solid var(--line);background:rgba(255,255,255,.04);color:var(--ink);padding:11px 18px;border-radius:11px;font-weight:700;font-size:14px;transition:.15s;display:inline-flex;gap:7px;align-items:center;text-decoration:none}
.btn:hover{border-color:var(--teal);transform:translateY(-1px)}
.btn.primary{background:var(--grad);color:#0b0a1f;border-color:transparent;font-weight:800}
.btn.primary:hover{filter:brightness(1.08)}
.btn.warn{background:var(--magenta);color:#fff;border-color:var(--magenta)}
.btn.ghost{background:transparent}
.btn:disabled{opacity:.45;cursor:not-allowed;transform:none}
.nav{display:flex;gap:6px;background:var(--panel);border:1px solid var(--line);padding:6px;border-radius:14px;margin:22px auto 22px;flex-wrap:wrap;justify-content:center}
.nav button{flex:1;min-width:84px;border:none;background:transparent;color:var(--mut);font-family:'Archivo';font-weight:700;padding:11px;border-radius:9px;cursor:pointer;font-size:13.5px;letter-spacing:.02em;transition:.15s}
.nav button:hover{color:var(--ink)}
.nav button.on{background:var(--grad);color:#0b0a1f}
.card{background:linear-gradient(180deg,var(--panel),#100e29);border:1px solid var(--line);border-radius:var(--radius);padding:20px;box-shadow:0 18px 50px -28px rgba(0,0,0,.8)}
.card+.card{margin-top:14px}
.field{margin-bottom:14px}
.field label{display:block;font-size:12px;color:var(--mut);margin-bottom:7px;font-weight:600;letter-spacing:.02em}
.inp{width:100%;background:#0c0a22;border:1px solid var(--line);color:var(--ink);padding:12px 14px;border-radius:11px;font-family:inherit;font-size:16px}
.inp:focus{outline:none;border-color:var(--teal);box-shadow:0 0 0 3px rgba(25,224,214,.15)}
.progress{height:12px;background:#0c0a22;border-radius:999px;overflow:hidden;border:1px solid var(--line)}
.progress>i{display:block;height:100%;background:var(--grad);transition:width .3s}
.match{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:center;background:var(--panel2);border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:10px}
.match:hover{border-color:#403a78}
.team{font-weight:700;font-size:15px}
.team.r{text-align:right}
.scoreboxes{display:flex;gap:6px;align-items:center;justify-content:center}
.sb{width:48px;height:46px;text-align:center;background:#0c0a22;border:1px solid var(--line);color:var(--ink);border-radius:10px;font-size:19px;font-weight:800;font-family:'Archivo'}
.sb:focus{outline:none;border-color:var(--teal);box-shadow:0 0 0 3px rgba(25,224,214,.15)}
.mmeta{font-size:11.5px;color:var(--mut);text-align:center;margin-top:6px;letter-spacing:.02em}
.lockpill{font-size:11px;color:var(--gold);text-align:center;margin-top:6px;font-weight:700}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.between{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.lb{width:100%;border-collapse:collapse;font-size:14px}
.lb th,.lb td{padding:12px 10px;text-align:left;border-bottom:1px solid var(--line)}
.lb th{color:var(--mut);font-weight:700;font-size:11px;text-transform:uppercase;letter-spacing:.08em}
.lb td.n{text-align:center;font-variant-numeric:tabular-nums}
.lb tbody tr:hover{background:rgba(255,255,255,.02)}
.tablewrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
@media(max-width:600px){
  .wrap{padding:0 12px}
  .card{padding:16px}
  .lb th,.lb td{padding:10px 7px;font-size:13px}
  .sb{width:42px;height:44px;font-size:18px}
  .match{padding:12px;gap:8px}
  .team{font-size:14px}
  .nav button{min-width:0;flex:1 1 30%;font-size:12.5px;padding:10px 6px}
  .testpanel{left:10px;right:10px;max-width:none;bottom:10px}
}
.rankbadge{display:inline-flex;width:26px;height:26px;align-items:center;justify-content:center;border-radius:8px;background:var(--panel2);font-weight:800;font-size:12px;font-family:'Archivo'}
.rankbadge.g1{background:var(--gold);color:#2a2000}
.rankbadge.g2{background:#cdd3ea;color:#10151f}
.rankbadge.g3{background:#e08a4a;color:#241000}
.note{font-size:12.5px;color:var(--mut);line-height:1.55}
.hint{background:rgba(255,255,255,.03);border:1px dashed var(--line);border-radius:12px;padding:13px;font-size:12.5px;color:var(--mut);margin-top:16px;line-height:1.6}
h2.sec{font-family:'Archivo';font-size:20px;font-weight:800;margin:2px 0 14px;letter-spacing:.01em;text-transform:uppercase}
h3.sub2{font-size:12px;color:var(--teal);text-transform:uppercase;letter-spacing:.14em;margin:22px 0 12px;font-weight:700;display:flex;align-items:center;gap:10px}
h3.sub2::after{content:"";flex:1;height:1px;background:var(--line)}
.adminmatch{display:grid;grid-template-columns:1fr 1fr 1fr 1fr 1fr auto;gap:7px;margin-bottom:8px}
.adminmatch .inp{padding:9px;font-size:13px}
@media(max-width:600px){.adminmatch{grid-template-columns:1fr 1fr}.logo{font-size:clamp(38px,12vw,60px)}}
.del{background:transparent;border:1px solid var(--line);color:var(--magenta);border-radius:8px;padding:8px 11px;cursor:pointer;font-weight:800}
.empty{text-align:center;color:var(--mut);padding:40px 20px;font-size:14px}
.spin{color:var(--mut);padding:60px;text-align:center}
.center{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:18px}
input[type=checkbox]{width:auto;accent-color:var(--teal)}
.testpanel{position:fixed;right:14px;bottom:14px;z-index:80;background:linear-gradient(180deg,#1d1a42,#100e29);border:1px solid var(--line);border-radius:14px;padding:13px 14px;max-width:320px;box-shadow:0 18px 50px -20px rgba(0,0,0,.85);font-size:12.5px}
